@article{dummypaper,
	title = {Dialectical and Analogical framework for LLM assisted ideation (Accepted)},
	url = {},
	preview={dsjconcept.jpg},
	abstract = {Creative thinking is an essential step in the process of design ideation, where analogical reasoning plays a crucial role in expanding the design concept space. The emergence of Generative AI has brought a significant revolution in co-creative systems, with various studies on Design-by-Analogy support tools. There is a lack of studies investigating the creative performance of LLM-generated analogical content and benchmarking of language models in creative tasks such as design ideation. Through this study, we aim to (i) investigate the effect of design heuristics by leveraging LLMs to generate analogical stimuli for novice designers in ideation tasks; (ii) evaluate and benchmark language models across analogical creative tasks. We developed a support tool based on the proposed conceptual framework and validated it by conducting controlled ideation experiments with 24 undergraduate design students. Groups assisted with the support tool generated higher-rated ideas (quality, novelty), thus validating the proposed framework. Benchmarking of the models revealed significant differences in the creative performance of analogies across different language models, suggesting that future studies should focus on AI benchmarking and evaluation across creative subjective tasks.},
	number = {},
	journal = {Design Science Journal},
	author = {Kokate, Rutvik and Onkar, Prasad},
	month = Dec,
	year = {2025},
	keywords = {Design ideation, large language models, natural language interac
tions, computer-aided ideation},
}

